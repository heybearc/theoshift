opt_out_usage

# Local store builds for the TheoShift phone app.
# Copying this to another app: change the four constants below, then
# point fastlane/.env at that app's upload keystore.

BUNDLE_ID = "app.theoshift.volunteer"
TEAM_ID = "S42AL6JZDB"
ASC_APP_ID = "6830737568"
IPA_NAME = "theoshift.ipa"

PROJECT = File.expand_path("..", __dir__)

default_platform(:ios)

def require_env!(*names)
  missing = names.select { |name| ENV[name].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!("Missing #{missing.join(', ')}. Copy fastlane/.env.example to fastlane/.env and fill it in.")
end

def asc_api_key
  require_env!("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_PATH")
  key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  UI.user_error!("ASC_KEY_PATH does not exist: #{key_path}") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

def replace_once!(path, pattern, label:)
  contents = File.read(path)
  updated = contents.sub(pattern) { yield Regexp.last_match }
  UI.user_error!("Could not update #{label} in #{path}") if updated == contents
  File.write(path, updated)
end

def bump_ios_build_number!
  path = File.join(PROJECT, "app.json")
  number = nil
  replace_once!(path, /("buildNumber"\s*:\s*")(\d+)(")/, label: "ios.buildNumber") do |match|
    number = (match[2].to_i + 1).to_s
    "#{match[1]}#{number}#{match[3]}"
  end
  UI.message("iOS build number is now #{number}")
  number
end

def bump_android_version_code!
  app_path = File.join(PROJECT, "app.json")
  gradle_path = File.join(PROJECT, "android/app/build.gradle")
  app_code = File.read(app_path)[/("versionCode"\s*:\s*)(\d+)/, 2].to_i
  gradle_code = File.exist?(gradle_path) ? File.read(gradle_path)[/versionCode\s+(\d+)/, 1].to_i : 0
  number = [app_code, gradle_code].max + 1
  replace_once!(app_path, /("versionCode"\s*:\s*)(\d+)/, label: "android.versionCode") do |match|
    "#{match[1]}#{number}"
  end
  UI.message("Android version code is now #{number}. Play Console rejects a code it has already received.")
  number
end

def without_bundler
  keys = %w[BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_PATH RUBYOPT BUNDLE_APP_CONFIG]
  saved_env = keys.to_h { |key| [key, ENV[key]] }
  saved_path = ENV["PATH"]
  keys.each { |key| ENV.delete(key) }
  ENV["PATH"] = saved_path.to_s.split(":").reject { |entry| entry.include?("vendor/bundle") }.join(":")
  yield
ensure
  saved_env&.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
  ENV["PATH"] = saved_path if saved_path
end

def prebuild!(platform)
  ENV["CI"] = "1"
  without_bundler do
    Dir.chdir(PROJECT) do
      sh("npx", "expo", "prebuild", "--platform", platform)
    end
  end
  restore_dev_scripts!
end

def restore_dev_scripts!
  path = File.join(PROJECT, "package.json")
  contents = File.read(path)
  contents = contents.sub('"android": "expo run:android"', '"android": "expo start --android"')
  contents = contents.sub('"ios": "expo run:ios"', '"ios": "expo start --ios"')
  File.write(path, contents)
end

def ios_workspace
  matches = Dir[File.join(PROJECT, "ios/*.xcworkspace")]
  UI.user_error!("expo prebuild did not create an Xcode workspace") if matches.empty?
  matches.first
end

def sign_ios!(api_key)
  cert(api_key: api_key, development: false, team_id: TEAM_ID)
  sigh(
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    team_id: TEAM_ID,
    platform: "ios",
    force: false
  )
end

def manual_ios_signing!
  workspace = ios_workspace
  project = workspace.sub(/\.xcworkspace\z/, ".xcodeproj")
  profile = lane_context[SharedValues::SIGH_NAME]
  update_code_signing_settings(
    use_automatic_signing: false,
    path: project,
    team_id: TEAM_ID,
    profile_name: profile,
    code_sign_identity: "Apple Distribution",
    bundle_identifier: BUNDLE_ID
  )
  [workspace, File.basename(workspace, ".xcworkspace"), profile]
end

def ensure_android_release_signing!
  path = File.join(PROJECT, "android/app/build.gradle")
  UI.user_error!("Missing #{path}. Run expo prebuild before signing.") unless File.exist?(path)
  contents = File.read(path)
  return if contents.include?("ANDROID_KEYSTORE_FILE")

  release_config = <<~GRADLE
        release {
            storeFile file(System.getenv("ANDROID_KEYSTORE_FILE"))
            storePassword System.getenv("ANDROID_KEYSTORE_PASSWORD")
            keyAlias System.getenv("ANDROID_KEY_ALIAS")
            keyPassword System.getenv("ANDROID_KEY_PASSWORD")
        }
  GRADLE
  updated = contents.sub(/signingConfigs \{\n        debug \{.*?\n        \}\n    \}/m) do |block|
    block.sub(/\n    \}\z/, "\n#{release_config}    }")
  end
  updated = updated.sub(
    /release \{\n            \/\/ Caution!.*?\n            signingConfig signingConfigs\.debug\n/m,
    "release {\n            signingConfig signingConfigs.release\n"
  )
  UI.user_error!("Could not point the Android release build at the upload keystore") if updated == contents
  File.write(path, updated)
end

platform :ios do
  desc "Create the Apple Distribution certificate and App Store profile on this Mac"
  lane :signing do
    setup_ci if ENV["CI"]
    sign_ios!(asc_api_key)
  end

  desc "Build an App Store ipa on this Mac and upload it to App Store Connect"
  lane :release do
    setup_ci if ENV["CI"]
    api_key = asc_api_key
    bump_ios_build_number!
    prebuild!("ios")
    sign_ios!(api_key)
    workspace, scheme, profile = manual_ios_signing!
    ipa = File.join(PROJECT, "build", IPA_NAME)

    gym(
      workspace: workspace,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store-connect",
      output_directory: File.dirname(ipa),
      output_name: IPA_NAME,
      clean: true,
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => profile
        }
      }
    )

    pilot(
      api_key: api_key,
      ipa: ipa,
      app_identifier: BUNDLE_ID,
      apple_id: ASC_APP_ID,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end

platform :android do
  desc "Build a Play App Bundle on this Mac and upload it to the internal track"
  lane :release do
    require_env!(
      "ANDROID_KEYSTORE_FILE",
      "ANDROID_KEYSTORE_PASSWORD",
      "ANDROID_KEY_ALIAS",
      "ANDROID_KEY_PASSWORD",
      "PLAY_JSON_KEY_PATH"
    )
    keystore = File.expand_path(ENV.fetch("ANDROID_KEYSTORE_FILE"))
    play_key = File.expand_path(ENV.fetch("PLAY_JSON_KEY_PATH"))
    UI.user_error!("ANDROID_KEYSTORE_FILE does not exist: #{keystore}") unless File.exist?(keystore)
    UI.user_error!("PLAY_JSON_KEY_PATH does not exist: #{play_key}") unless File.exist?(play_key)

    ENV["ANDROID_KEYSTORE_FILE"] = keystore
    bump_android_version_code!
    prebuild!("android")
    ensure_android_release_signing!

    Dir.chdir(File.join(PROJECT, "android")) do
      sh("./gradlew", "bundleRelease")
    end

    aab = File.join(PROJECT, "android/app/build/outputs/bundle/release/app-release.aab")
    UI.user_error!("Gradle did not produce #{aab}") unless File.exist?(aab)

    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "internal"),
      aab: aab,
      json_key: play_key,
      package_name: BUNDLE_ID,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end
