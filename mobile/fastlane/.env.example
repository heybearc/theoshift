# Copy to fastlane/.env. That file is gitignored.
# App Store Connect → Users and Access → Integrations → Team Keys.
# Role: App Manager. Download the .p8 once and store it outside the repo.

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Upload key already registered with Play Console.
# Download it from the Expo account: eas credentials -p android
# A newly generated keystore will be rejected for this existing app.

ANDROID_KEYSTORE_FILE=/absolute/path/to/upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Play Console → Setup → API access → service account JSON.
PLAY_JSON_KEY_PATH=/absolute/path/to/play-service-account.json
PLAY_TRACK=internal
