  OVERSEER
  ASSISTANT_OVERSEER
  DEPARTMENT_HEAD
  STATION_OVERSEER
}

enum PositionRole {
  OVERSEER
  KEYMAN
  ATTENDANT // Legacy - kept for backward compatibility
  VOLUNTEER // Standard volunteer assignment role (refactor terminology)
}

enum UserRole {
  ADMIN
  OVERSEER
  ASSISTANT_OVERSEER
  KEYMAN
  VOLUNTEER
  ATTENDANT // Legacy value still in database - will be migrated later
}
