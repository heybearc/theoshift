model ivs_import_batches {
  id              String              @id @default(uuid())
  eventId         String              @map("event_id")
  requestRound    Int                 @map("request_round")
  importedBy      String              @map("imported_by")
  importedAt      DateTime            @default(now()) @map("imported_at")
  fileName        String              @map("file_name")
  departmentName  String?             @map("department_name")
  volunteerCount  Int                 @default(0) @map("volunteer_count")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  
  // Relations
  event           events              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  importedByUser  users               @relation(fields: [importedBy], references: [id], onDelete: NoAction)
  volunteers      event_volunteers[]
  
  @@index([eventId])
  @@index([requestRound])
  @@index([importedAt])
}

