generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model user_activity {
  id             String    @id @default(uuid())
  userId         String
  sessionId      String    @unique
  loginAt        DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  logoutAt       DateTime?
  ipAddress      String?
  userAgent      String?
  serverNode     String?
  isActive       Boolean   @default(true)
  users          users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([lastActivityAt])
  @@index([serverNode])
}

model announcements {
  id        String    @id
  eventId   String
  title     String
  message   String
  type      String?   @default("INFO")
  isActive  Boolean?  @default(true)
  startDate DateTime? @db.Timestamp(6)
  endDate   DateTime? @db.Timestamp(6)
  createdBy String
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  users     users     @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events    events    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([endDate], map: "announcements_enddate_idx")
  @@index([eventId], map: "announcements_eventid_idx")
  @@index([isActive], map: "announcements_isactive_idx")
  @@index([startDate], map: "announcements_startdate_idx")
}

model global_announcements {
  id        String    @id
  title     String
  message   String
  type      String    @default("INFO")
  isActive  Boolean   @default(true)
  startDate DateTime? @db.Timestamp(6)
  endDate   DateTime? @db.Timestamp(6)
  createdBy String
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
  users     users     @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([isActive], map: "global_announcements_isactive_idx")
  @@index([startDate], map: "global_announcements_startdate_idx")
  @@index([endDate], map: "global_announcements_enddate_idx")
}

model assignments {
  id                 String                     @id
  eventId            String
  userId             String
  positionId         String
  shiftId            String?
  shiftStart         DateTime
  shiftEnd           DateTime
  status             AssignmentStatus           @default(ASSIGNED)
  notes              String?
  assignedBy         String?
  assignedAt         DateTime                   @default(now())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime
  confirmationStatus String?                    @default("PENDING") @map("confirmation_status")
  confirmationToken  String?                    @unique @map("confirmation_token")
  confirmedAt        DateTime?                  @map("confirmed_at")
  confirmationNotes  String?                    @map("confirmation_notes")
  declinedReason     String?                    @map("declined_reason")
  events             events                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  users              users                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications      assignment_notifications[]

  @@index([confirmationStatus])
  @@index([confirmedAt])
}

model volunteers {
  id                            String                           @id
  userId                        String?                          @unique
  firstName                     String
  lastName                      String
  email                         String                           @unique
  phone                         String?
  availabilityStatus            String?                          @default("AVAILABLE")
  isAvailable                   Boolean                          @default(true)
  notes                         String?
  servingAs                     Json?                            @default("[]")
  skills                        Json?
  preferredDepartments          Json?
  unavailableDates              Json?
  totalAssignments              Int                              @default(0)
  totalHours                    Float                            @default(0)
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime
  congregation                  String
  formsOfService                Json                             @default("[]")
  isActive                      Boolean                          @default(true)
  profileVerificationRequired   Boolean                          @default(false)
  profileVerifiedAt             DateTime?
  user                          users?                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  document_publications         document_publications[]
  event_volunteers_primary      event_volunteers[]               @relation("event_volunteers_volunteerIdTovolunteers")
  event_volunteers_keyman       event_volunteers[]               @relation("event_volunteers_keymanIdTovolunteers")
  event_volunteers_overseer     event_volunteers[]               @relation("event_volunteers_overseerIdTovolunteers")
  position_assignments_primary  position_assignments[]           @relation("position_assignments_volunteerIdTovolunteers")
  position_assignments_keyman   position_assignments[]           @relation("position_assignments_keymanIdTovolunteers")
  position_assignments_overseer position_assignments[]           @relation("position_assignments_overseerIdTovolunteers")
  position_oversight_keyman     position_oversight_assignments[] @relation("position_oversight_assignments_keyman_idTovolunteers")
  position_oversight_overseer   position_oversight_assignments[] @relation("position_oversight_assignments_overseer_idTovolunteers")
  count_session_position_assignees count_session_position_assignees[]
  primary_count_session_groups    count_session_groups[]            @relation("count_session_groups_primary")
  secondary_count_session_groups  count_session_groups[]            @relation("count_session_groups_secondary")
  volunteer_availability        volunteer_availability[]
  chat_members                 event_chat_members[]
  chat_messages                event_chat_messages[]                @relation("event_chat_messages_sender_volunteer")
  chat_reads                   event_chat_reads[]
  chat_push_subscriptions      event_chat_push_subscriptions[]
}

model count_sessions {
  id              String             @id
  eventId         String
  sessionName     String
  countTime       DateTime?
  notes           String?
  verificationMode String             @default("single")
  status          CountSessionStatus @default(ACTIVE)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime
  uploadedAt      DateTime           @default(now())
  uploadedBy      String?
  events          events             @relation(fields: [eventId], references: [id])
  assignees       count_session_position_assignees[]
  groups          count_session_groups[]
  groupPositions  count_session_group_positions[]
  position_counts position_counts[]

  @@unique([eventId, sessionName])
}

model document_publications {
  id              String          @id
  documentId      String
  volunteerId     String
  publishedAt     DateTime        @default(now())
  viewedAt        DateTime?
  downloadedAt    DateTime?
  volunteer       volunteers      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  event_documents event_documents @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, volunteerId])
  @@index([volunteerId], map: "idx_document_publications_attendant")
  @@index([documentId], map: "idx_document_publications_document")
}

model email_configurations {
  id                 String   @id
  smtpServer         String
  smtpPort           Int
  smtpUser           String
  smtpPassword       String
  fromEmail          String
  fromName           String
  replyToEmail       String?
  inviteTemplate     String?
  assignmentTemplate String?
  reminderTemplate   String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
}

// NOTE: This model maps to the 'event_attendants' table in the database
// The table was originally named 'event_attendants' but the model is 'event_volunteers'
// We keep the @@map directive to maintain compatibility without requiring DBA access
// See /docs/TABLE_RENAME_PLAN.md for details
//
// Event-Specific Roles (Option 1 Architecture):
// isKeyman, isOverseer, isElder are event-specific flags
// A volunteer can be a keyman in Event A but not in Event B
// See /docs/VOLUNTEER_ROLES_ARCHITECTURE.md for details
model event_volunteers {
  id                      String                 @id
  eventId                 String
  userId                  String?
  role                    UserRole               @default(ATTENDANT)
  isActive                Boolean                @default(true)
  assignedDepartments     Json?
  assignedStationRanges   Json?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime
  volunteerId             String?
  keymanId                String?
  overseerId              String?
  
  // Event-specific role flags (Option 1 Architecture)
  isKeyman                Boolean                @default(false) @map("is_keyman")
  isOverseer              Boolean                @default(false) @map("is_overseer")
  isElder                 Boolean                @default(false) @map("is_elder")
  
  // True when this person is on the Volunteers / Positions roster.
  // IVS imports create event_volunteers rows with this false so they stay IVS-only
  // until explicitly added via the Volunteers page (same unique event+volunteer row).
  onVolunteerRoster       Boolean                @default(false) @map("on_volunteer_roster")

  // IVS Approval Workflow Fields (optional, null if not using IVS module)
  ivsApprovalStatus       String?                @map("ivs_approval_status")
  ivsSubmittedBy          String?                @map("ivs_submitted_by")
  ivsRequestRound         Int?                   @map("ivs_request_round")
  ivsApprovalRequestedAt  DateTime?              @map("ivs_approval_requested_at")
  ivsApprovalNotes        String?                @map("ivs_approval_notes")
  ivsApprovedAt           DateTime?              @map("ivs_approved_at")
  ivsApprovedBy           String?                @map("ivs_approved_by")
  ivsDeniedReason         String?                @map("ivs_denied_reason")
  ivsImportBatchId        String?                @map("ivs_import_batch_id")
  
  // Early Check-In — per convention day (Fri/Sat/Sun)
  earlyCheckinEligible    Boolean?               @default(false) @map("early_checkin_eligible")
  earlyCheckinFriday      Boolean                @default(false) @map("early_checkin_friday")
  earlyCheckinSaturday    Boolean                @default(false) @map("early_checkin_saturday")
  earlyCheckinSunday      Boolean                @default(false) @map("early_checkin_sunday")
  checkedInAt             DateTime?              @map("checked_in_at")
  checkedInBy             String?                @map("checked_in_by")
  checkinNotes            String?                @map("checkin_notes")
  
  // Relations
  volunteer               volunteers?            @relation("event_volunteers_volunteerIdTovolunteers", fields: [volunteerId], references: [id], onDelete: Cascade)
  events                  events                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  keyman                  volunteers?            @relation("event_volunteers_keymanIdTovolunteers", fields: [keymanId], references: [id])
  overseer                volunteers?            @relation("event_volunteers_overseerIdTovolunteers", fields: [overseerId], references: [id])
  users                   users?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch             ivs_import_batches?    @relation(fields: [ivsImportBatchId], references: [id], onDelete: SetNull)
  earlyCheckins           event_volunteer_early_checkins[]

  @@unique([eventId, volunteerId])
  @@unique([eventId, userId])
  @@index([ivsApprovalStatus])
  @@index([ivsRequestRound])
  @@index([ivsImportBatchId])
  @@index([earlyCheckinEligible])
}

enum ConventionDay {
  FRIDAY
  SATURDAY
  SUNDAY
}

model event_volunteer_early_checkins {
  id               String         @id
  eventVolunteerId String         @map("event_volunteer_id")
  conventionDay    ConventionDay  @map("convention_day")
  checkedInAt      DateTime       @default(now()) @map("checked_in_at")
  checkedInBy      String?        @map("checked_in_by")
  checkinNotes     String?        @map("checkin_notes")
  createdAt        DateTime       @default(now()) @map("created_at")

  eventVolunteer event_volunteers @relation(fields: [eventVolunteerId], references: [id], onDelete: Cascade)

  @@unique([eventVolunteerId, conventionDay])
  @@index([eventVolunteerId])
  @@map("event_volunteer_early_checkins")
}

model event_documents {
  id                    String                  @id
  eventId               String
  title                 String
  description           String?
  fileName              String
  fileUrl               String
  fileType              String
  fileSize              Int
  uploadedBy            String
  uploadedAt            DateTime                @default(now())
  publishedTo           String                  @default("none")
  publishedCount        Int                     @default(0)
  publishedAt           DateTime?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  document_publications document_publications[]
  events                events                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "idx_event_documents_event")
  @@index([uploadedBy], map: "idx_event_documents_uploader")
}

model event_permissions {
  id        String              @id
  userId    String
  eventId   String
  role      EventPermissionRole @default(VIEWER)
  scopeType EventScopeType?
  scopeIds  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime
  events    events              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  users     users               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([eventId, role])
  @@index([userId])
}

model locations {
  id         String   @id @default(cuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  notes      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  usageCount Int      @default(0) @map("usage_count")
  users      users?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  events     events[]
}

model events {
  id                             String                           @id
  name                           String
  description                    String?
  status                         EventStatus                      @default(UPCOMING)
  startDate                      DateTime                         @db.Date
  endDate                        DateTime                         @db.Date
  location                       String?
  venue                          String?
  locationId                     String?                          @map("location_id")
  isActive                       Boolean                          @default(true)
  settings                       Json?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime
  createdBy                      String?
  startTime                      String?
  endTime                        String?
  eventType                      EventType                        @default(CIRCUIT_ASSEMBLY)
  volunteersNeeded               Int?
  capacity                       Int?
  departmentOverseerAssistants   Json?                            @default("[]") @map("department_overseer_assistants")
  departmentOverseerEmail        String?                          @map("department_overseer_email")
  departmentOverseerName         String?                          @map("department_overseer_name")
  departmentOverseerPhone        String?                          @map("department_overseer_phone")
  departmentOverseerUserId       String?                          @map("department_overseer_user_id")
  keyman                         Json?                            @default("[]")
  parentEventId                  String?                          @map("parent_event_id")
  locationRef                    locations?                       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notificationSettings           Json?                            @map("notification_settings")
  announcements                  announcements[]
  assignments                    assignments[]
  count_sessions                 count_sessions[]
  event_volunteers               event_volunteers[]
  event_documents                event_documents[]
  event_permissions              event_permissions[]
  lanyard_settings               lanyard_settings?
  oversight_assignments          oversight_assignments[]
  position_oversight_assignments position_oversight_assignments[]
  positions                      positions[]
  volunteer_availability         volunteer_availability[]
  ivs_import_batches             ivs_import_batches[]
  chat_channels                  event_chat_channels[]
  parentEvent                    events?                          @relation("EventHierarchy", fields: [parentEventId], references: [id], onDelete: Cascade)
  childEvents                    events[]                         @relation("EventHierarchy")

  @@index([parentEventId])
}

model feedback {
  id                   String                 @id
  feedbackNumber       String?                @unique
  type                 FeedbackType
  title                String
  description          String
  priority             FeedbackPriority       @default(MEDIUM)
  status               FeedbackStatus         @default(NEW)
  resolutionComment    String?
  submittedBy          String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  users                users                  @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
  feedback_attachments feedback_attachments[]
  feedback_comments    feedback_comments[]
}

model feedback_attachments {
  id         String   @id
  feedbackId String
  filename   String
  filePath   String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())
  feedback   feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model feedback_comments {
  id         String   @id
  feedbackId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  users      users    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  feedback   feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model lanyard_settings {
  id                String     @id
  eventId           String     @unique
  totalLanyards     Int
  availableLanyards Int
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  events            events     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lanyards          lanyards[]
}

model lanyards {
  id               String           @id
  lanyardSettingId String
  badgeNumber      String
  isCheckedOut     Boolean          @default(false)
  checkedOutTo     String?
  checkedOutAt     DateTime?
  checkedInAt      DateTime?
  status           LanyardStatus    @default(AVAILABLE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  lanyard_settings lanyard_settings @relation(fields: [lanyardSettingId], references: [id], onDelete: Cascade)

  @@unique([lanyardSettingId, badgeNumber])
}

model oversight_assignments {
  id             String          @id
  eventId        String
  userId         String
  departmentId   String?
  stationRangeId String?
  oversightLevel OversightLevel
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  events         events          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  station_ranges station_ranges? @relation(fields: [stationRangeId], references: [id])
  users          users           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model position_assignments {
  id          String           @id
  positionId  String
  shiftId     String?
  volunteerId String
  role        PositionRole
  overseerId  String?
  keymanId    String?
  assignedAt  DateTime         @default(now())
  assignedBy  String?
  users       users?           @relation(fields: [assignedBy], references: [id])
  volunteer   volunteers       @relation("position_assignments_volunteerIdTovolunteers", fields: [volunteerId], references: [id], onDelete: Cascade)
  keyman      volunteers?      @relation("position_assignments_keymanIdTovolunteers", fields: [keymanId], references: [id])
  overseer    volunteers?      @relation("position_assignments_overseerIdTovolunteers", fields: [overseerId], references: [id])
  positions   positions        @relation("PositionToAssignments", fields: [positionId], references: [id], onDelete: Cascade)
  shift       position_shifts? @relation("ShiftToAssignments", fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([positionId, shiftId, volunteerId])
  @@index([volunteerId])
  @@index([overseerId, keymanId])
  @@index([positionId, shiftId])
  @@index([role])
}

model position_counts {
  id             String         @id
  countSessionId String
  positionId     String
  attendeeCount  Int?
  notes          String?
  countedBy      String?
  countedAt      DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  count_sessions count_sessions @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  position       positions      @relation("PositionToCounts", fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([countSessionId, positionId])
}

model count_session_groups {
  id                  String                        @id @default(uuid())
  countSessionId      String
  name                String
  primaryVolunteerId  String?
  secondaryVolunteerId String?
  createdBy           String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  countSession        count_sessions                @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  primaryVolunteer    volunteers?                   @relation("count_session_groups_primary", fields: [primaryVolunteerId], references: [id], onDelete: SetNull)
  secondaryVolunteer  volunteers?                   @relation("count_session_groups_secondary", fields: [secondaryVolunteerId], references: [id], onDelete: SetNull)
  createdByUser       users?                        @relation("count_session_groups_created_by", fields: [createdBy], references: [id], onDelete: SetNull)
  positions           count_session_group_positions[]
  entry               count_group_entries?

  @@index([countSessionId])
}

model count_session_group_positions {
  id             String              @id @default(uuid())
  countSessionId String
  groupId        String
  positionId     String
  createdAt      DateTime            @default(now())
  countSession   count_sessions      @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  group          count_session_groups @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position       positions           @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([countSessionId, positionId])
  @@unique([groupId, positionId])
  @@index([countSessionId, groupId])
}

model count_group_entries {
  id             String               @id @default(uuid())
  groupId        String               @unique
  attendeeCount  Int?
  notes          String?
  enteredBy      String?
  enteredAt      DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  group          count_session_groups @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enteredByUser  users?               @relation("count_group_entries_entered_by", fields: [enteredBy], references: [id], onDelete: SetNull)
}

model count_session_position_assignees {
  id             String         @id @default(uuid())
  countSessionId String
  positionId     String
  volunteerId    String
  isSuggested    Boolean        @default(false)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  countSession   count_sessions @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  position       positions      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  volunteer      volunteers     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdByUser  users?         @relation("count_session_position_assigneesTousers", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([countSessionId, positionId, volunteerId])
  @@index([countSessionId, positionId])
  @@index([volunteerId])
}

model position_oversight_assignments {
  id         String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  positionId String      @map("position_id")
  eventId    String      @map("event_id")
  overseerId String?     @map("overseer_id")
  keymanId   String?     @map("keyman_id")
  assignedBy String?     @map("assigned_by")
  createdAt  DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime?   @default(now()) @map("updated_at") @db.Timestamp(6)
  users      users?      @relation(fields: [assignedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events     events      @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  keyman     volunteers? @relation("position_oversight_assignments_keyman_idTovolunteers", fields: [keymanId], references: [id], onUpdate: NoAction)
  overseer   volunteers? @relation("position_oversight_assignments_overseer_idTovolunteers", fields: [overseerId], references: [id], onUpdate: NoAction)
  positions  positions   @relation("PositionToOversight", fields: [positionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([positionId, eventId])
  @@index([eventId], map: "idx_position_oversight_event")
  @@index([keymanId], map: "idx_position_oversight_keyman")
  @@index([overseerId], map: "idx_position_oversight_overseer")
  @@index([positionId], map: "idx_position_oversight_position")
}

model position_shifts {
  id                   String                 @id
  positionId           String
  isAllDay             Boolean                @default(false)
  createdAt            DateTime               @default(now())
  endTime              String?
  name                 String
  sequence             Int
  startTime            String?
  /// Calendar day for multi-day events (null = undated / single-day legacy)
  shiftDate            DateTime?              @db.Date
  /// How many people should serve on this shift (default 1 = legacy behavior)
  volunteersNeeded     Int                    @default(1)
  position_assignments position_assignments[] @relation("ShiftToAssignments")
  positions            positions              @relation("PositionToShifts", fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([positionId, sequence])
  @@index([positionId, shiftDate])
}

model positions {
  id             String                           @id
  eventId        String
  positionNumber Int
  name           String
  description    String?
  area           String?
  sequence       Int
  isActive       Boolean                          @default(true)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime
  assignments    position_assignments[]           @relation("PositionToAssignments")
  assignees      count_session_position_assignees[]
  countGroups    count_session_group_positions[]
  counts         position_counts[]                @relation("PositionToCounts")
  oversight      position_oversight_assignments[] @relation("PositionToOversight")
  shifts         position_shifts[]                @relation("PositionToShifts")
  events         events                           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, positionNumber])
  @@index([eventId, isActive])
  @@index([eventId, sequence])
}

model shift_templates {
  id               String   @id
  name             String
  description      String?
  shifts           Json
  isSystemTemplate Boolean  @default(false)
  createdBy        String?
  createdAt        DateTime @default(now())
  users            users?   @relation(fields: [createdBy], references: [id])

  @@index([isSystemTemplate])
}

model station_ranges {
  id                    String                  @id
  departmentId          String
  name                  String
  startStation          Int
  endStation            Int
  description           String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  oversight_assignments oversight_assignments[]
}

model system_settings {
  id        String   @id
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime
  createdBy String?
  updatedBy String?
}

model users {
  id                             String                           @id
  email                          String                           @unique
  firstName                      String
  lastName                       String
  phone                          String?
  isActive                       Boolean                          @default(true)
  role                           UserRole                         @default(VOLUNTEER)
  passwordHash                   String?
  inviteToken                    String?                          @unique
  inviteExpiry                   DateTime?
  lastLogin                      DateTime?
  lastSeenReleaseVersion         String?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime
  createdBy                      String?
  name                           String?
  image                          String?
  emailVerified                  DateTime?
  congregation                   String?
  Account                        Account[]
  Session                        Session[]
  user_activity                  user_activity[]
  announcements                  announcements[]
  global_announcements           global_announcements[]
  assignments                    assignments[]
  volunteer                      volunteers?
  event_volunteers               event_volunteers[]
  event_permissions              event_permissions[]
  feedback                       feedback[]
  feedback_comments              feedback_comments[]
  oversight_assignments          oversight_assignments[]
  position_assignments           position_assignments[]
  count_session_position_assignees count_session_position_assignees[] @relation("count_session_position_assigneesTousers")
  created_count_session_groups   count_session_groups[]                @relation("count_session_groups_created_by")
  entered_count_group_entries    count_group_entries[]                 @relation("count_group_entries_entered_by")
  position_oversight_assignments position_oversight_assignments[]
  shift_templates                shift_templates[]
  locations                      locations[]
  ivs_import_batches             ivs_import_batches[]
  admin_view_as_audit_logs       admin_view_as_audit_logs[]
  chat_members                   event_chat_members[]
  chat_messages                  event_chat_messages[]            @relation("event_chat_messages_sender_user")
  chat_reads                     event_chat_reads[]
  chat_push_subscriptions        event_chat_push_subscriptions[]
}

model admin_view_as_audit_logs {
  id                String   @id @default(uuid())
  adminUserId       String
  targetVolunteerId String?
  eventId           String?
  action            String
  createdAt         DateTime @default(now())
  adminUser         users    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([eventId, createdAt])
}

// ============================================================================
// Phase 4C: Assignment Workflow Enhancements
// ============================================================================

model assignment_notifications {
  id               String      @id @default(uuid())
  assignmentId     String      @map("assignment_id")
  notificationType String      @map("notification_type")
  recipientEmail   String      @map("recipient_email")
  sentAt           DateTime    @default(now()) @map("sent_at")
  status           String      @default("sent")
  errorMessage     String?     @map("error_message")
  emailSubject     String?     @map("email_subject")
  emailBody        String?     @map("email_body")
  createdAt        DateTime    @default(now()) @map("created_at")
  assignment       assignments @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([notificationType])
  @@index([status])
  @@index([sentAt])
}

model volunteer_availability {
  id             String     @id @default(uuid())
  eventId        String     @map("event_id")
  volunteerId    String     @map("volunteer_id")
  status         String
  notes          String?
  availableDates Json?      @map("available_dates")
  availableTimes Json?      @map("available_times")
  requestedAt    DateTime   @default(now()) @map("requested_at")
  respondedAt    DateTime?  @map("responded_at")
  reminderSentAt DateTime?  @map("reminder_sent_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  event          events     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer      volunteers @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
  @@index([eventId])
  @@index([volunteerId])
  @@index([status])
  @@index([respondedAt])
}

model event_chat_channels {
  id          String           @id @default(uuid())
  eventId     String           @map("event_id")
  type        ChatChannelType
  name        String
  positionId  String?          @map("position_id")
  /// Sorted volunteer ids (min lexicographic first) when type is VOLUNTEER_DM; null for other channel types.
  dmVolunteerAId String?       @map("dm_volunteer_a_id")
  dmVolunteerBId String?       @map("dm_volunteer_b_id")
  pinnedMessageId String?      @map("pinned_message_id") // DB column is TEXT (matches event_chat_messages.id)
  isArchived  Boolean          @default(false) @map("is_archived")
  createdBy   String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  event       events           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     event_chat_members[]
  messages    event_chat_messages[]
  reads       event_chat_reads[]
  pinnedMessage event_chat_messages? @relation("ChannelPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  @@unique([eventId, type, positionId])
  @@index([eventId, isArchived])
  @@index([positionId])
}

model event_chat_members {
  id           String         @id @default(uuid())
  channelId    String         @map("channel_id")
  userId       String?        @map("user_id")
  volunteerId  String?        @map("volunteer_id")
  role         ChatMemberRole @default(MEMBER)
  mutedUntil   DateTime?      @map("muted_until")
  joinedAt     DateTime       @default(now()) @map("joined_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  channel      event_chat_channels @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user         users?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer    volunteers?    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@unique([channelId, volunteerId])
  @@index([channelId])
  @@index([userId])
  @@index([volunteerId])
}

model event_chat_messages {
  id                String       @id @default(uuid())
  channelId         String       @map("channel_id")
  senderUserId      String?      @map("sender_user_id")
  senderVolunteerId String?      @map("sender_volunteer_id")
  kind              ChatMessageKind @default(TEXT)
  body              String
  editedAt          DateTime?    @map("edited_at")
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  channel           event_chat_channels @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderUser        users?       @relation("event_chat_messages_sender_user", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderVolunteer   volunteers?  @relation("event_chat_messages_sender_volunteer", fields: [senderVolunteerId], references: [id], onDelete: SetNull)
  pinnedInChannels  event_chat_channels[] @relation("ChannelPinnedMessage")

  @@index([channelId, createdAt])
  @@index([senderUserId])
  @@index([senderVolunteerId])
}

model event_chat_reads {
  id                String   @id @default(uuid())
  channelId         String   @map("channel_id")
  userId            String?  @map("user_id")
  volunteerId       String?  @map("volunteer_id")
  lastReadMessageId String?  @map("last_read_message_id")
  lastReadAt        DateTime @default(now()) @map("last_read_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  channel           event_chat_channels @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user              users?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer         volunteers? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@unique([channelId, volunteerId])
  @@index([channelId])
}

model event_chat_push_subscriptions {
  id          String     @id @default(uuid())
  userId      String?    @map("user_id")
  volunteerId String?    @map("volunteer_id")
  endpoint    String
  p256dh      String
  auth        String
  userAgent   String?    @map("user_agent")
  lastSeenAt  DateTime?  @map("last_seen_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user        users?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer   volunteers? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
  @@index([volunteerId])
}

