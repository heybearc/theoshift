{
  "name": "theoshift",
  "version": "4.32.2",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "validate-config": "node scripts/validate-config.js",
    "prebuild": "npm run validate-config && npx prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/lib",
    "test:e2e": "playwright test tests/smoke-test.spec.ts tests/release-gate",
    "test:e2e:full": "playwright test",
    "test:e2e:container": "bash scripts/test-runner.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test tests/smoke-test.spec.ts",
    "test:smoke:quick": "playwright test tests/smoke-test.spec.ts --workers=1",
    "test:report": "playwright show-report test-results/html-report",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@react-google-maps/api": "^2.20.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.15",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "formidable": "^3.5.4",
    "gray-matter": "^4.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "marked": "^16.4.1",
    "next": "15.5.12",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.15.0",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
