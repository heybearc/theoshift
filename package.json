{
  "name": "theoshift",
  "version": "4.45.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "validate-config": "node scripts/validate-config.js",
    "prebuild": "npm run validate-config && npx prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/lib",
    "test:e2e": "playwright test tests/smoke-test.spec.ts tests/release-gate",
    "test:e2e:full": "playwright test",
    "test:e2e:container": "bash scripts/test-runner.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test tests/smoke-test.spec.ts",
    "test:smoke:quick": "playwright test tests/smoke-test.spec.ts --workers=1",
    "test:report": "playwright show-report test-results/html-report",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-google-maps/api": "^2.20.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/formidable": "^3.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "formidable": "^3.5.4",
    "gray-matter": "^4.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
