    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  }
